---
import Layout from "@/layouts/Layout.astro";
import ChildToday from "@/components/family/ChildToday";
import type { ChildChore } from "@/components/family/ChildToday";
import ParentToday from "@/components/family/ParentToday";
import type { ParentChild, ParentTodayView } from "@/components/family/ParentToday";
import { getCurrentProfile } from "@/lib/profile";
import { createAdminClient } from "@/lib/supabase-admin";
import { createClient } from "@/lib/supabase";
import { warsawToday } from "@/lib/today";

const serverError = Astro.url.searchParams.get("error");
const choreAdded = Astro.url.searchParams.get("added") === "1";
const choreChecked = Astro.url.searchParams.get("checked") === "1";
const choreUndone = Astro.url.searchParams.get("undone") === "1";

let view: ParentTodayView = "unavailable";
let child: ParentChild | null = null;
let showChild = false;
let childChores: ChildChore[] = [];
let childChoresLoadFailed = false;

function isTimestampOrNull(value: unknown): value is string | null {
  return value === null || typeof value === "string";
}

function parseChildChore(raw: unknown): ChildChore | null {
  if (typeof raw !== "object" || raw === null) {
    return null;
  }
  if (!("id" in raw) || !("title" in raw) || !("child_checked_at" in raw) || !("parent_confirmed_at" in raw)) {
    return null;
  }
  if (typeof raw.id !== "string" || typeof raw.title !== "string") {
    return null;
  }
  if (!isTimestampOrNull(raw.child_checked_at)) {
    return null;
  }
  if (!isTimestampOrNull(raw.parent_confirmed_at)) {
    return null;
  }

  return {
    id: raw.id,
    title: raw.title,
    childCheckedAt: raw.child_checked_at,
    parentConfirmedAt: raw.parent_confirmed_at,
  };
}

const supabase = createClient(Astro.request.headers, Astro.cookies);
if (supabase) {
  const profile = await getCurrentProfile(supabase);
  if (profile?.role === "parent") {
    const childrenResult = await supabase
      .from("profiles")
      .select("id, display_name")
      .eq("family_id", profile.family_id)
      .eq("role", "child")
      .order("created_at", { ascending: true })
      .limit(1);

    if (childrenResult.error || !Array.isArray(childrenResult.data)) {
      view = "child-unavailable";
    } else if (childrenResult.data.length === 0) {
      view = "add-child";
    } else {
      const raw: unknown = childrenResult.data[0];
      if (
        typeof raw !== "object" ||
        raw === null ||
        !("id" in raw) ||
        !("display_name" in raw) ||
        typeof raw.id !== "string" ||
        typeof raw.display_name !== "string"
      ) {
        view = "child-unavailable";
      } else {
        let email: string | null = null;
        const admin = createAdminClient();
        if (admin) {
          try {
            const authUser = await admin.auth.admin.getUserById(raw.id);
            if (!authUser.error && authUser.data.user.email) {
              email = authUser.data.user.email;
            }
          } catch {
            // Admin lookup threw; keep the child on screen without a login email.
          }
        }
        view = "child";
        child = {
          id: raw.id,
          displayName: raw.display_name,
          email,
        };
      }
    }
  } else if (profile?.role === "child") {
    showChild = true;
    const choresResult = await supabase
      .from("today_chores")
      .select("id, title, child_checked_at, parent_confirmed_at, created_at")
      .eq("child_profile_id", profile.id)
      .eq("chore_date", warsawToday())
      .order("created_at", { ascending: true })
      .order("id", { ascending: true });

    if (choresResult.error || !Array.isArray(choresResult.data)) {
      childChoresLoadFailed = true;
    } else {
      const parsed: ChildChore[] = [];
      for (const item of choresResult.data) {
        const raw: unknown = item;
        const row = parseChildChore(raw);
        if (!row) {
          childChoresLoadFailed = true;
          break;
        }
        parsed.push(row);
      }
      if (!childChoresLoadFailed) {
        childChores = parsed;
      }
    }
  }
}
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-2xl border border-white/10 bg-white/10 p-8 text-white backdrop-blur-xl">
      <h1 class="mb-6 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-center text-2xl font-bold text-transparent">
        Dashboard
      </h1>
      {showChild ? (
        <ChildToday
          serverError={serverError}
          loadFailed={childChoresLoadFailed}
          chores={childChores}
          choreChecked={choreChecked}
          choreUndone={choreUndone}
          client:load
        />
      ) : (
        <ParentToday serverError={serverError} view={view} child={child} choreAdded={choreAdded} client:load />
      )}
      <form method="POST" action="/api/auth/signout" class="mt-6 text-center">
        <button
          type="submit"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Sign out
        </button>
      </form>
    </div>
  </div>
</Layout>
